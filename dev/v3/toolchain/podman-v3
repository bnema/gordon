#!/bin/sh
# Explicit isolated development engine. Never invoke the packaged engine here.
set -eu
[ "$(id -u)" -ne 0 ] || { printf '%s\n' 'rootless account required' >&2; exit 1; }
: "${HOME:?}" "${XDG_RUNTIME_DIR:?}"
export CONTAINERS_CONF=/opt/gordon-v3-toolchain/containers.conf
export CONTAINERS_STORAGE_CONF=/opt/gordon-v3-toolchain/storage.conf
export XDG_DATA_HOME="$HOME/.local/share/gordon-v3-toolchain"
export XDG_CONFIG_HOME="$HOME/.config/gordon-v3-toolchain"
export PATH="/opt/gordon-v3-toolchain/bin:$PATH"
exec /opt/gordon-v3-toolchain/bin/podman "$@"
